# ============================================
# NexusAI Environment Configuration
# ============================================
# Copy to .env and set values (never commit .env).
# ============================================

# --- AI ---
OPENROUTER_API_KEY=your_openrouter_api_key_here

# --- Security ---
# Development: optional (a random key is generated each run if unset).
# Production: required, min 32 characters.
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-super-secret-key-change-in-production

# --- Environment ---
# production: enables stricter defaults; use Gunicorn (see wsgi.py), not `python run.py`
# FLASK_ENV=production
# Or: NEXUS_PRODUCTION=true

# Public site URL (OpenRouter Referer, links). Use your real domain in production.
APP_URL=http://127.0.0.1:5000

# Behind nginx/Traefik with TLS termination:
# TRUST_PROXY=true
# PREFERRED_URL_SCHEME=https
# SESSION_COOKIE_SECURE=true

# Session cookie lifetime (hours)
# SESSION_LIFETIME_HOURS=168

# --- Rate limiting ---
# RATELIMIT_ENABLED=true
# For Redis-backed limits across instances: RATELIMIT_STORAGE_URI=redis://localhost:6379

# --- Git clone allowlist (comma-separated hostnames) ---
# GIT_ALLOWED_HOSTS=github.com,www.github.com,gitlab.com,www.gitlab.com,bitbucket.org

# --- Capacity ---
# MAX_SERVER_SESSIONS=2000

# --- Speech-to-Text (STT) ---
# Provider options: 'assemblyai', 'openai', 'local'
STT_PROVIDER=local

# AssemblyAI (if STT_PROVIDER=assemblyai)
# ASSEMBLYAI_API_KEY=

# OpenAI Whisper API (if STT_PROVIDER=openai)
# OPENAI_API_KEY=

# If using Redis queues / presence for collaborative editor and workers
# REDIS_URL=redis://localhost:6379/0
